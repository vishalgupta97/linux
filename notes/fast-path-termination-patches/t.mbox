> > +                                       enforce_expected_attach_type:1, /* Enforce expected_attach_type checking at attach time */
> > +                                       call_get_stack:1, /* Do we call bpf_get_stack() or bpf_get_stackid() */
> > +                                       call_get_func_ip:1, /* Do we call get_func_ip() */
